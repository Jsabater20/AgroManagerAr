generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  nombre           String
  password         String
  rol              Rol       @default(OPERADOR)
  rolGlobal        String    @default("USER")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  resetToken       String?
  resetTokenExpiry DateTime?
  mpSuscripcionId  String?
  plan             PlanTipo  @default(FREE)
  planExpira       DateTime?
  emailVerificado  Boolean   @default(false)
  emailVerifToken  String?
  apellido         String    @default("")
  fotoPerfilStorageKey String?
  trialUsado       Boolean   @default(false)

  animales                       Animal[]
  auditoriasLogs                 AuditoriaLog[]           @relation("auditoriaLogs")
  campanias                      Campania[]
  campos                         Campo[]
  invitaciones                   InvitacionOrganizacion[]
  maquinarias                    Maquinaria[]
  movimientos                    MovimientoFinanciero[]
  organizacionesQueEsDueno       Organizacion[]           @relation("organizacion_owner")
  empresasQueEsDueno             Empresa[]                @relation("empresa_owner")
  membresiasEmpresa              UsuarioEmpresa[]
  tareas                         TareaRural[]
  membresiasOrganizacion         UsuarioOrganizacion[]
  actividadesCreadasParaMiembros ActividadMiembro[]       @relation("creadoPor")
  observacionesActividades       ObservacionActividad[]   @relation("autorObservaciones")
  dispositivosPush               DispositivoPush[]
  evidencias                     Evidencia[]              @relation("evidenciasCreadasPor")
}

model DispositivoPush {
  id            Int      @id @default(autoincrement())
  usuarioId     Int
  expoPushToken String   @unique
  plataforma    String
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model Campo {
  id              Int                    @id @default(autoincrement())
  nombre          String
  hectareas       Float
  ubicacion       String?
  propietario     String?
  usuarioId       Int
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  latitud         Float?
  longitud        Float?
  organizacionId  Int?
  AsignacionCampo AsignacionCampo[]
  organizacion    Organizacion?          @relation(fields: [organizacionId], references: [id])
  usuario         Usuario                @relation(fields: [usuarioId], references: [id])
  lotes           Lote[]
  maquinarias     Maquinaria[]
  movimentos      MovimientoFinanciero[]
  tareas          TareaRural[]

  @@index([organizacionId])
}

model Lote {
  id        Int       @id @default(autoincrement())
  nombre    String
  hectareas Float
  campoId   Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  campo     Campo     @relation(fields: [campoId], references: [id])
  siembras  Siembra[]
}

model TipoCultivo {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique
  descripcion String?
  createdAt   DateTime  @default(now())
  siembras    Siembra[]
}

model Siembra {
  id            Int                    @id @default(autoincrement())
  loteId        Int
  tipoCultivoId Int
  fechaSiembra  DateTime
  densidad      Float?
  observaciones String?
  estado        EstadoSiembra          @default(EN_CURSO)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  campaniaId    Int?
  aplicaciones  AplicacionInsumo[]
  cosechas      Cosecha[]
  movimentos    MovimientoFinanciero[]
  campania      Campania?              @relation(fields: [campaniaId], references: [id])
  lote          Lote                   @relation(fields: [loteId], references: [id])
  tipoCultivo   TipoCultivo            @relation(fields: [tipoCultivoId], references: [id])
}

model Cosecha {
  id              Int      @id @default(autoincrement())
  siembraId       Int
  fechaCosecha    DateTime
  rendimientoKgHa Float
  totalKg         Float
  humedad         Float?
  observaciones   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  siembra         Siembra  @relation(fields: [siembraId], references: [id])
}

model Insumo {
  id           Int                @id @default(autoincrement())
  nombre       String
  tipo         TipoInsumo
  unidad       String
  descripcion  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  aplicaciones AplicacionInsumo[]
}

model AplicacionInsumo {
  id            Int      @id @default(autoincrement())
  siembraId     Int
  insumoId      Int
  fecha         DateTime
  cantidad      Float
  unidad        String
  observaciones String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  insumo        Insumo   @relation(fields: [insumoId], references: [id])
  siembra       Siembra  @relation(fields: [siembraId], references: [id])
}

model Animal {
  id              Int             @id @default(autoincrement())
  usuarioId       Int
  nombre          String
  especie         Especie
  sexo            Sexo
  categoria       CategoriaAnimal
  peso            Float?
  fechaNacimiento DateTime?
  observaciones   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  organizacionId  Int?
  organizacion    Organizacion?   @relation(fields: [organizacionId], references: [id])
  usuario         Usuario         @relation(fields: [usuarioId], references: [id])
  preneces        Prenez[]
  pesos           RegistroPeso[]

  @@index([organizacionId])
}

model Prenez {
  id                 Int          @id @default(autoincrement())
  animalId           Int
  fechaInicio        DateTime
  fechaEstimadaParto DateTime
  estado             EstadoPrenez @default(EN_CURSO)
  observaciones      String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  animal             Animal       @relation(fields: [animalId], references: [id], onDelete: Cascade)
}

model TareaRural {
  id              Int           @id @default(autoincrement())
  usuarioId       Int
  titulo          String
  descripcion     String?
  tipo            TipoTarea
  estado          EstadoTarea   @default(PENDIENTE)
  prioridad       Prioridad     @default(MEDIA)
  fechaProgramada DateTime
  fechaCompletada DateTime?
  campoId         Int?
  observaciones   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  fechaLimite     DateTime?
  repetir         RepetirTarea  @default(UNICA)
  organizacionId  Int?
  campo           Campo?        @relation(fields: [campoId], references: [id])
  organizacion    Organizacion? @relation(fields: [organizacionId], references: [id])
  usuario         Usuario       @relation(fields: [usuarioId], references: [id])

  @@index([organizacionId])
}

model Maquinaria {
  id                Int                       @id @default(autoincrement())
  usuarioId         Int
  campoId           Int?
  nombre            String
  tipo              TipoMaquinaria
  marca             String?
  modelo            String?
  anio              Int?
  patente           String?
  estado            EstadoMaquinaria          @default(OPERATIVA)
  horasUso          Float?
  seguroVencimiento DateTime?
  vtvVencimiento    DateTime?
  observaciones     String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  organizacionId    Int?
  gastos            GastoMaquinaria[]
  mantenimientos    MantenimientoMaquinaria[]
  campo             Campo?                    @relation(fields: [campoId], references: [id])
  organizacion      Organizacion?             @relation(fields: [organizacionId], references: [id])
  usuario           Usuario                   @relation(fields: [usuarioId], references: [id])

  @@index([organizacionId])
}

model MantenimientoMaquinaria {
  id                   Int               @id @default(autoincrement())
  maquinariaId         Int
  tipo                 TipoMantenimiento
  descripcion          String?
  fecha                DateTime
  horasUso             Float?
  costo                Float?
  proximoMantenimiento DateTime?
  observaciones        String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  maquinaria           Maquinaria        @relation(fields: [maquinariaId], references: [id], onDelete: Cascade)
}

model GastoMaquinaria {
  id            Int          @id @default(autoincrement())
  maquinariaId  Int
  tipo          TipoGastoMaq
  descripcion   String
  monto         Float
  fecha         DateTime
  observaciones String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  maquinaria    Maquinaria   @relation(fields: [maquinariaId], references: [id], onDelete: Cascade)
}

model MovimientoFinanciero {
  id             Int                 @id @default(autoincrement())
  usuarioId      Int
  tipo           TipoMovimiento
  concepto       String
  monto          Float
  fecha          DateTime
  categoria      CategoriaMovimiento
  campoId        Int?
  siembraId      Int?
  observaciones  String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organizacionId Int?
  campo          Campo?              @relation(fields: [campoId], references: [id])
  organizacion   Organizacion?       @relation(fields: [organizacionId], references: [id])
  siembra        Siembra?            @relation(fields: [siembraId], references: [id])
  usuario        Usuario             @relation(fields: [usuarioId], references: [id])

  @@index([organizacionId])
}

model Campania {
  id             Int           @id @default(autoincrement())
  usuarioId      Int
  nombre         String
  fechaInicio    DateTime
  fechaFin       DateTime?
  descripcion    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organizacionId Int?
  organizacion   Organizacion? @relation(fields: [organizacionId], references: [id])
  usuario        Usuario       @relation(fields: [usuarioId], references: [id])
  siembras       Siembra[]

  @@index([organizacionId])
}

model RegistroPeso {
  id            Int      @id @default(autoincrement())
  animalId      Int
  peso          Float
  fecha         DateTime
  observaciones String?
  createdAt     DateTime @default(now())
  animal        Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
}

model Organizacion {
  id                   Int                      @id @default(autoincrement())
  nombre               String
  email                String                   @unique
  plan                 PlanTipo                 @default(FREE)
  propietarioId        Int
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  animales             Animal[]
  asignacionesRecursos AsignacionRecurso[]
  auditoriasLogs       AuditoriaLog[]           @relation("auditoriaLogs")
  campanias            Campania[]
  campos               Campo[]
  invitaciones         InvitacionOrganizacion[]
  maquinarias          Maquinaria[]
  movimientos          MovimientoFinanciero[]
  propietario          Usuario                  @relation("organizacion_owner", fields: [propietarioId], references: [id])
  rolesPersonalizados  RolPersonalizado[]
  tareas               TareaRural[]
  miembros             UsuarioOrganizacion[]
  actividades          ActividadMiembro[]
  evidencias           Evidencia[]
  vinculacionEmpresa   EmpresaOrganizacion?
  autorizacionesEmpresa UsuarioEmpresaOrganizacion[]

  @@index([propietarioId])
}

model UsuarioOrganizacion {
  id                  Int                 @id @default(autoincrement())
  usuarioId           Int
  organizacionId      Int
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  roles               String              @default("[]")
  activo              Boolean             @default(true)
  fechaInvitacion     DateTime            @default(now())
  AsignacionCampo     AsignacionCampo[]
  asignacionesPermiso AsignacionPermiso[] @relation("asignacionesPermiso")
  asignaciones        AsignacionRecurso[]
  organizacion        Organizacion        @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  usuario             Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  VisibilidadModulo   VisibilidadModulo[]
  actividades         ActividadMiembro[]

  @@unique([usuarioId, organizacionId])
  @@index([usuarioId])
  @@index([organizacionId])
}

model AsignacionRecurso {
  id                    Int                 @id @default(autoincrement())
  usuarioOrganizacionId Int
  organizacionId        Int
  recursoTipo           TipoRecurso
  recursoId             Int
  permisosTipo          String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  Organizacion          Organizacion        @relation(fields: [organizacionId], references: [id])
  usuarioOrganizacion   UsuarioOrganizacion @relation(fields: [usuarioOrganizacionId], references: [id], onDelete: Cascade)

  @@unique([usuarioOrganizacionId, recursoTipo, recursoId])
  @@index([usuarioOrganizacionId])
  @@index([organizacionId, recursoTipo, recursoId])
}

model InvitacionOrganizacion {
  id             Int              @id @default(autoincrement())
  organizacionId Int
  email          String
  rol            RolOrganizacion  @default(OPERARIO)
  token          String           @unique
  estado         EstadoInvitacion @default(PENDIENTE)
  mensaje        String?
  expiresAt      DateTime
  aceptadoEn     DateTime?
  usuarioId      Int?
  createdAt      DateTime         @default(now())
  organizacion   Organizacion     @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  usuario        Usuario?         @relation(fields: [usuarioId], references: [id])

  @@index([email])
  @@index([token])
  @@index([organizacionId])
}

model RolPersonalizado {
  id             Int                 @id @default(autoincrement())
  organizacionId Int
  nombre         String
  descripcion    String?
  activo         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  asignaciones   AsignacionPermiso[]
  organizacion   Organizacion        @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@unique([organizacionId, nombre])
  @@index([organizacionId])
}

model AsignacionPermiso {
  id                    Int                 @id @default(autoincrement())
  usuarioOrganizacionId Int
  rolPersonalizadoId    Int
  recursoTipo           String?
  recursoId             Int?
  fechaInicio           DateTime
  fechaVencimiento      DateTime
  activo                Boolean             @default(true)
  notas                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  rolPersonalizado      RolPersonalizado    @relation(fields: [rolPersonalizadoId], references: [id], onDelete: Cascade)
  usuarioOrganizacion   UsuarioOrganizacion @relation("asignacionesPermiso", fields: [usuarioOrganizacionId], references: [id], onDelete: Cascade)

  @@index([usuarioOrganizacionId])
  @@index([rolPersonalizadoId])
  @@index([fechaVencimiento])
}

model AuditoriaLog {
  id             Int           @id @default(autoincrement())
  usuarioId      Int
  organizacionId Int?
  accion         String
  entidad        String?
  entidadId      Int?
  cambios        String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  organizacion   Organizacion? @relation("auditoriaLogs", fields: [organizacionId], references: [id])
  usuario        Usuario       @relation("auditoriaLogs", fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([organizacionId])
  @@index([createdAt])
  @@index([accion])
}

model AsignacionCampo {
  id                    Int                 @id @default(autoincrement())
  usuarioOrganizacionId Int
  campoId               Int
  activo                Boolean             @default(true)
  fechaAsignacion       DateTime            @default(now())
  Campo                 Campo               @relation(fields: [campoId], references: [id], onDelete: Cascade)
  UsuarioOrganizacion   UsuarioOrganizacion @relation(fields: [usuarioOrganizacionId], references: [id], onDelete: Cascade)

  @@unique([usuarioOrganizacionId, campoId])
  @@index([campoId])
}

model VisibilidadModulo {
  id                    Int                 @id @default(autoincrement())
  usuarioOrganizacionId Int
  moduloNombre          String
  activo                Boolean             @default(true)
  fechaHabilitacion     DateTime            @default(now())
  UsuarioOrganizacion   UsuarioOrganizacion @relation(fields: [usuarioOrganizacionId], references: [id], onDelete: Cascade)

  @@unique([usuarioOrganizacionId, moduloNombre])
  @@index([usuarioOrganizacionId])
}

model ActividadMiembro {
  id                    Int  @id @default(autoincrement())
  organizacionId        Int
  usuarioOrganizacionId Int
  creadoPorId           Int?

  titulo      String
  descripcion String?

  recursoTipo TipoRecursoActividad
  recursoId   Int?
  contexto    String?

  fechaInicio      DateTime
  fechaEstimadaFin DateTime
  fechaRealFin     DateTime?

  estado    EstadoActividad @default(PENDIENTE)
  prioridad Prioridad       @default(MEDIA)

  activo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  observaciones       ObservacionActividad[]
  organizacion        Organizacion           @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  usuarioOrganizacion UsuarioOrganizacion    @relation(fields: [usuarioOrganizacionId], references: [id], onDelete: Restrict)
  creadoPor           Usuario?               @relation("creadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)

  @@index([organizacionId, estado])
  @@index([usuarioOrganizacionId, estado])
  @@index([creadoPorId])
  @@index([organizacionId, activo])
}

model ObservacionActividad {
  id                 Int  @id @default(autoincrement())
  actividadMiembroId Int
  autorId            Int?

  contenido                String
  fotoBase64               String?
  idempotencyKey           String?        @unique
  estadoActividadAlMomento EstadoActividad

  createdAt DateTime @default(now())

  actividad ActividadMiembro @relation(fields: [actividadMiembroId], references: [id], onDelete: Restrict)
  autor     Usuario?         @relation("autorObservaciones", fields: [autorId], references: [id], onDelete: SetNull)

  @@index([actividadMiembroId, createdAt])
}

model Empresa {
  id                       Int                    @id @default(autoincrement())
  nombre                   String
  activo                   Boolean                @default(true)
  limiteEstablecimientos   Int                    @default(3)
  propietarioId            Int
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  propietario              Usuario                @relation("empresa_owner", fields: [propietarioId], references: [id], onDelete: Restrict)
  organizaciones           EmpresaOrganizacion[]
  miembros                 UsuarioEmpresa[]

  @@index([propietarioId])
  @@index([activo])
}

model EmpresaOrganizacion {
  id             Int          @id @default(autoincrement())
  empresaId      Int
  organizacionId Int          @unique
  createdAt      DateTime     @default(now())
  empresa        Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@unique([empresaId, organizacionId])
  @@index([empresaId])
}

model UsuarioEmpresa {
  id                        Int                              @id @default(autoincrement())
  empresaId                 Int
  usuarioId                 Int
  rol                       RolEmpresa
  activo                    Boolean                          @default(true)
  accesoTodasOrganizaciones Boolean                          @default(false)
  createdAt                 DateTime                         @default(now())
  updatedAt                 DateTime                         @updatedAt
  empresa                   Empresa                          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario                   Usuario                          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  organizacionesAutorizadas UsuarioEmpresaOrganizacion[]

  @@unique([empresaId, usuarioId])
  @@index([usuarioId])
  @@index([empresaId, activo])
}

model UsuarioEmpresaOrganizacion {
  id               Int            @id @default(autoincrement())
  usuarioEmpresaId Int
  organizacionId   Int
  createdAt        DateTime       @default(now())
  usuarioEmpresa   UsuarioEmpresa @relation(fields: [usuarioEmpresaId], references: [id], onDelete: Cascade)
  organizacion     Organizacion   @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@unique([usuarioEmpresaId, organizacionId])
  @@index([organizacionId])
}

model Evidencia {
  id             String           @id @default(uuid())
  organizacionId Int
  usuarioId      Int
  origen         OrigenEvidencia
  tipoRecurso    TipoRecursoEvidencia
  recursoId      Int
  comentario     String?
  fechaHora      DateTime         @default(now())
  estado         EstadoEvidencia  @default(PENDIENTE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organizacion Organizacion       @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  usuario      Usuario            @relation("evidenciasCreadasPor", fields: [usuarioId], references: [id], onDelete: Restrict)
  archivos     ArchivoEvidencia[]

  @@index([organizacionId, tipoRecurso, recursoId, fechaHora])
  @@index([usuarioId])
  @@index([estado, createdAt])
}

model ArchivoEvidencia {
  id           String    @id @default(uuid())
  evidenciaId  String
  storageKey   String    @unique
  nombre       String
  mimeType     String
  tamanoBytes  Int
  ancho        Int?
  alto         Int?
  createdAt    DateTime  @default(now())

  evidencia Evidencia @relation(fields: [evidenciaId], references: [id], onDelete: Cascade)

  @@index([evidenciaId])
}

enum Rol {
  ADMIN
  OPERADOR
}

enum PlanTipo {
  FREE
  PRO
}

enum RolEmpresa {
  OWNER
  ADMINISTRADOR
  GERENTE_GENERAL
  GERENTE_ESTABLECIMIENTO
  SUPERVISOR
  RESPONSABLE_FINANCIERO
}

enum EstadoSiembra {
  EN_CURSO
  COSECHADA
  PERDIDA
}

enum TipoInsumo {
  FERTILIZANTE
  HERBICIDA
  FUNGICIDA
  INSECTICIDA
  SEMILLA
  OTRO
}

enum Especie {
  BOVINO
  PORCINO
  EQUINO
  OVINO
  CAPRINO
  AVIAR
}

enum Sexo {
  MACHO
  HEMBRA
}

enum CategoriaAnimal {
  VACA
  VAQUILLONA
  TERNERA
  TORO
  NOVILLO
  TERNERO
  CERDA
  VERRACO
  LECHON
  YEGUA
  POTRANCA
  PADRILLO
  POTRO
  OVEJA
  BORREGA
  CARNERO
  CORDERO
  CABRA
  CABRIO
  CABRITO
  GALLINA
  GALLO
  POLLO
  POLLA
}

enum EstadoPrenez {
  EN_CURSO
  COMPLETADA
  PERDIDA
}

enum TipoTarea {
  SIEMBRA
  COSECHA
  FUMIGACION
  FERTILIZACION
  RIEGO
  MANTENIMIENTO
  VETERINARIA
  OTRO
}

enum EstadoTarea {
  PENDIENTE
  EN_CURSO
  COMPLETADA
  CANCELADA
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum RepetirTarea {
  UNICA
  SEMANAL
  QUINCENAL
  MENSUAL
}

enum TipoMaquinaria {
  TRACTOR
  SEMBRADORA
  PULVERIZADORA
  COSECHADORA
  CAMIONETA
  MIXER
  ACOPLADO
  TOLVA
  HERRAMIENTA
  OTRO
}

enum EstadoMaquinaria {
  OPERATIVA
  EN_MANTENIMIENTO
  FUERA_DE_SERVICIO
}

enum TipoMantenimiento {
  CAMBIO_ACEITE
  REVISION_GENERAL
  REPARACION
  OTRO
}

enum TipoGastoMaq {
  COMBUSTIBLE
  REPARACION
  REPUESTO
  SERVICIO
  SEGURO
  OTRO
}

enum TipoMovimiento {
  INGRESO
  EGRESO
}

enum CategoriaMovimiento {
  COSECHA
  VENTA_ANIMAL
